# Canonical URL of this running instance used in metadata, sitemaps, and
# the OAuth redirect URI. Must exactly match what's registered in the
# Discord Developer Portal and in Popplio/Arcadia's own redirect allowlists.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Popplio API base URL. Defaults to staging if unset.
# NEXT_PUBLIC_API_URL=https://spider-staging.omniplex.gg

# Asset CDN base URL (bot/server/team avatars and banners). Defaults to
# production CDN if unset. Override only if you're running your own.
# NEXT_PUBLIC_CDN_URL=https://cdn.omniplex.gg

# Arcadia panel API base URL, which powers /admin. Defaults to staging if unset.
# NEXT_PUBLIC_ARCADIA_URL=https://staging--panel-api.omniplex.gg

# Arcadia's configured panel_scope for this instance. Must match Arcadia's
# own config exactly or staff login will fail.
# NEXT_PUBLIC_ARCADIA_PANEL_SCOPE=infinity-list

# Short-link domains, comma-separated (for example botlist.site,example.gg).
# A request on one of these hosts to /<bot id or vanity> redirects to that
# listing on NEXT_PUBLIC_BASE_URL, and the first domain is the one the "Short
# link" button copies. Read at runtime, so adding a domain only needs a
# restart. Point each domain's DNS at this deployment first.
# SHORT_LINK_DOMAINS=botlist.site
