# This deployment's own URL (for example https://panel.omniplex.gg). Staff
# sign-in sends Discord back to <this URL>/auth/callback, which must be in
# Arcadia's arcadia.panel.redirect_url list and the Discord app's redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# The public website, for links to listings, tickets and images under /cdn.
# NEXT_PUBLIC_SITE_URL=https://omniplex.gg

# Popplio API base URL. The staff panel calls it straight from the browser,
# without the website's session cookie.
# NEXT_PUBLIC_API_URL=https://spider-staging.omniplex.gg

# Asset CDN base URL.
# NEXT_PUBLIC_CDN_URL=https://cdn.omniplex.gg

# Arcadia panel API base URL. Defaults to production if unset.
# NEXT_PUBLIC_ARCADIA_URL=https://staging--panel-api.omniplex.gg

# Arcadia's configured panel_scope for this instance. Must match Arcadia's
# own config exactly or staff login will fail.
# NEXT_PUBLIC_ARCADIA_PANEL_SCOPE=infinity-list

# S3 storage for partner logo uploads, the same values as the website's.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
