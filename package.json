{
  "name": "omniplex",
  "private": true,
  "description": "Omniplex monorepo: the omniplex.gg website and the official API SDKs.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@omniplex/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "baseline-browser-mapping": "^2.11.0",
    "js-yaml": "^3.15.1",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  }
}
